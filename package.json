{
  "name": "kintore-lab",
  "version": "1.0.0",
  "private": true,
  "description": "筋トレLAB — iOS(Capacitor)ラッパー。Web版は素の静的サイトのまま、iOSは www/ を内包してビルドする。",
  "type": "module",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "npm run build:www && cap sync",
    "ios:open": "npm run build:www && cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^5.0.1",
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capgo/capacitor-health": "^7.2.15",
    "@revenuecat/purchases-capacitor": "^13.2.4"
  }
}
